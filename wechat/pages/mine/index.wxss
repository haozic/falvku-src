/* 我的页 */

.stat-card {
  display: flex;
  padding: 14px 0;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 20px;
  font-weight: 600;
  color: var(--text);
}

.stat-label {
  font-size: 12px;
  color: var(--text-subtle);
  margin-top: 2px;
}

.me-row {
  display: flex;
  align-items: center;
  padding: 13px 0;
  border-bottom: 1px solid var(--border);
}

.me-row:last-child {
  border-bottom: 0;
}

.me-icon {
  width: 18px;
  height: 18px;
  margin-right: 10px;
  flex: none;
  opacity: 0.75;
}

.m-label {
  flex: 1;
  font-size: 14px;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.m-count {
  font-size: 12px;
  color: var(--text-subtle);
  margin-right: 8px;
  flex: none;
}

.me-arrow {
  width: 14px;
  height: 14px;
  flex: none;
  opacity: 0.4;
  transition: transform 0.18s ease;
}

.me-arrow.open {
  transform: rotate(180deg);
}

.card-title {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-muted);
  margin-bottom: 4px;
}

/* 自建条目 */
.custom-item {
  border-top: 1px solid var(--border);
  margin-top: 12px;
  padding-top: 12px;
}

.ci-title {
  font-size: 14px;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 4px;
}

.ci-text {
  font-size: 13px;
  color: var(--text-muted);
  line-height: 1.6;
}

.ci-actions {
  margin-top: 10px;
}

.ci-actions .btn {
  margin-right: 8px;
}

.about {
  font-size: 11px;
  color: var(--text-subtle);
  text-align: center;
  padding: 14px 0 6px 0;
  line-height: 1.7;
}
