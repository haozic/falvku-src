<view class="root {{themeClass}}">

  <view class="section-head">
    <text class="section-title">法规体系</text>
    <text class="section-more" bindtap="toggleAll">{{allOpen ? '全部收起' : '全部展开'}}</text>
  </view>
  <view class="desc">共 {{groups.length}} 个体系 · {{catCount}} 个门类，点门类进入分类浏览</view>

  <view class="card group" wx:for="{{groups}}" wx:key="id">
    <view class="group-head" data-id="{{item.id}}" bindtap="onToggle">
      <view class="group-dot" style="background:{{item.color}}"></view>
      <text class="group-name">{{item.name}}</text>
      <text class="group-count">{{item.total}} 部</text>
      <image class="group-arrow {{item.open ? 'open' : ''}}" src="/images/ic-chevron-down.png" mode="aspectFit" />
    </view>
    <view class="group-desc" wx:if="{{item.desc}}">{{item.desc}}</view>

    <view class="group-body" wx:if="{{item.open}}">
      <view
        class="cat-row"
        wx:for="{{item.cats}}"
        wx:for-item="c"
        wx:key="id"
        data-id="{{c.id}}"
        bindtap="onCatTap"
      >
        <text class="cr-name">{{c.name}}</text>
        <text class="cr-count">{{c.count}} 部</text>
        <image class="cr-arrow" src="/images/ic-chevron.png" mode="aspectFit" />
      </view>
    </view>
  </view>

</view>
