<view class="root {{themeClass}}">

  <!-- ① 检索卡 -->
  <view class="section">
    <view class="card">
      <view class="stat-row">
        <view class="stat-cell">
          <view class="stat-num">{{total}}</view>
          <view class="stat-label">部法规</view>
        </view>
        <view class="stat-cell">
          <view class="stat-num">{{totalCharsText}}</view>
          <view class="stat-label">万字</view>
        </view>
        <view class="stat-cell">
          <view class="stat-num">{{catCount}}</view>
          <view class="stat-label">个门类</view>
        </view>
        <view class="stat-cell">
          <view class="stat-num">{{groupCount}}</view>
          <view class="stat-label">个体系</view>
        </view>
      </view>
      <view class="searchbar">
        <input
          class="sb-input"
          value="{{query}}"
          placeholder="检索党章党规、法律法规条文…"
          confirm-type="search"
          bindinput="onInput"
          bindconfirm="onSearch"></input>
        <view class="sb-btn" bindtap="onSearch">检索</view>
      </view>
    </view>
  </view>

  <!-- 加载失败 -->
  <view class="section" wx:if="{{error}}">
    <view class="card">
      <view class="empty">
        <image src="/images/ic-none.png" mode="aspectFit" />
        <view class="empty-title">无法连接后端服务</view>
        <view class="empty-sub">{{error}}</view>
        <view class="btn btn-primary btn-sm" style="margin-top:16px;" bindtap="load">重试</view>
      </view>
    </view>
  </view>

  <block wx:if="{{!error}}">

    <!-- ② 法规体系（体系级概览，门类明细去「体系」页看） -->
    <view class="section">
      <view class="section-head">
        <text class="section-title">法规体系</text>
        <text class="section-more" bindtap="goTree">全部门类 ›</text>
      </view>
      <view class="sys-grid">
        <view
          class="sys-card"
          wx:for="{{groups}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onGroupTap"
        >
          <view class="sys-top">
            <view class="sys-dot" style="background:{{item.color}}"></view>
            <text class="sys-name">{{item.name}}</text>
            <text class="sys-count">{{item.total}} 部</text>
          </view>
          <view class="sys-cats">{{item.catNames}}</view>
        </view>
      </view>
    </view>

    <!-- ③ 最近检索 -->
    <view class="section" wx:if="{{history.length}}">
      <view class="section-head">
        <text class="section-title">最近检索</text>
        <text class="section-more" bindtap="clearHistory">清空</text>
      </view>
      <view class="chips">
        <view
          class="chip"
          wx:for="{{history}}"
          wx:key="*this"
          data-q="{{item}}"
          bindtap="onHistoryTap"
        >{{item}}</view>
      </view>
    </view>

    <!-- ④ 最新发布 -->
    <view class="section" wx:if="{{latest.length}}">
      <view class="section-head">
        <text class="section-title">最新发布</text>
        <text class="section-more" bindtap="goTimeline">时间轴 ›</text>
      </view>
      <view class="doc-list">
        <view
          class="doc-item"
          wx:for="{{latest}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onDocTap"
        >
          <view class="doc-title">{{item.title}}</view>
          <view class="doc-meta">
            <text class="badge badge-accent">{{item.catName}}</text>
            <text class="meta-txt" wx:if="{{item.publishedText}}">{{item.publishedText}}</text>
          </view>
        </view>
      </view>    </view>

  </block>

</view>
