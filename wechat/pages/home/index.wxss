/* 首页
 *
 * 只放「打开就能用」的东西：检索卡 / 体系概览 / 最近检索 / 最新发布。
 * 门类明细在「体系」页，最近浏览与收藏笔记在「我的」页 —— 不在这里重复。
 *
 * 布局说明：小程序 WXSS 不用 CSS Grid（老 WebView 支持不稳），
 * 一律用 flex + 百分比宽度，与仓库里「Chrome 69 兼容」的口径一致。
 */

/* ---------------- 统计条（4 格） ---------------- */

.stat-row {
  display: flex;
  align-items: flex-end;
  margin-bottom: 14px;
}

.stat-cell {
  flex: 1 1 0;
  min-width: 0;
  margin-right: 6px;
}

.stat-cell:last-child {
  margin-right: 0;
}

.stat-num {
  font-size: 17px;
  font-weight: 600;
  line-height: 1.3;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.stat-label {
  font-size: 11px;
  color: var(--text-subtle);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ---------------- 体系概览卡片（2 列） ---------------- */

.sys-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -5px;
}

.sys-card {
  width: calc(50% - 10px);
  margin: 5px;
  padding: 12px 13px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
  box-sizing: border-box;
}

.sys-top {
  display: flex;
  align-items: center;
  margin-bottom: 6px;
}

.sys-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  margin-right: 6px;
  flex: none;
}

.sys-name {
  font-size: 14px;
  font-weight: 600;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.sys-count {
  font-size: 11px;
  color: var(--text-subtle);
  margin-left: auto;
  padding-left: 6px;
  white-space: nowrap;
}

.sys-cats {
  font-size: 11px;
  line-height: 1.6;
  color: var(--text-muted);
  overflow: hidden;
  max-height: 2.4em;
}

/* ---------------- 最新发布列表 ---------------- */

.doc-list .doc-item {
  margin-bottom: 10px;
}
