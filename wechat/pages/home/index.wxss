/* 首页 */

.hero-title {
  font-size: 17px;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 6px;
}

.hero-desc {
  font-size: 12px;
  color: var(--text-muted);
  line-height: 1.6;
  margin-bottom: 12px;
}

.hero-hint {
  font-size: 11px;
  color: var(--text-subtle);
  margin-top: 10px;
}

.group-block {
  margin-bottom: 18px;
}

.group-head {
  display: flex;
  align-items: center;
  margin-bottom: 6px;
}

.group-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  margin-right: 8px;
  flex: none;
}

.group-name {
  font-size: 15px;
  font-weight: 600;
  color: var(--text);
}

.group-count {
  font-size: 12px;
  color: var(--text-subtle);
  margin-left: auto;
}

.group-desc {
  margin-bottom: 10px;
}
