/* 检索页 */

.sbar {
  margin-bottom: 10px;
}

.hint {
  font-size: 11px;
  color: var(--text-subtle);
  margin-bottom: 10px;
}

.chips-scroll {
  white-space: nowrap;
  height: 40px;
  margin-bottom: 6px;
}

.chips-scroll .chip {
  margin-bottom: 0;
  margin-top: 4px;
}

.toolbar {
  display: flex;
  align-items: center;
  margin-bottom: 12px;
}

.sorts {
  display: flex;
  flex: none;
}

.sort {
  font-size: 12px;
  color: var(--text-muted);
  border: 1px solid var(--border);
  background: var(--surface);
  border-radius: 999px;
  padding: 4px 11px;
  margin-right: 6px;
  white-space: nowrap;
}

.sort-on {
  background: var(--accent);
  color: var(--on-accent);
  border-color: transparent;
}

.count {
  font-size: 12px;
  color: var(--text-muted);
  margin-left: auto;
  white-space: nowrap;
}

.load-more {
  text-align: center;
  padding: 16px 0;
  color: var(--text-subtle);
  font-size: 13px;
}
